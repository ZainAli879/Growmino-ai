OPENAI_API_KEY="your-openai-api-key"
INFIP_API_KEY="your-infip-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

TEXT_PROVIDER=openai
CAPTION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1
OPENROUTER_HTTP_REFERER=https://your-site.example
OPENROUTER_APP_NAME=ai-postgen

IMAGE_PROVIDER=infip
INFIP_BASE_URL=https://api.infip.pro/v1
INFIP_IMAGE_MODEL=img4
INFIP_IMAGE_RESPONSE_FORMAT=url

# Custom provider (used only when IMAGE_PROVIDER=custom)
CUSTOM_IMAGE_BASE_URL=https://your-custom-image-api.example
CUSTOM_IMAGE_STEPS=20
CUSTOM_IMAGE_GUIDANCE=4.0
CUSTOM_IMAGE_N=1
CUSTOM_IMAGE_SEED=1
IMAGE_SIZE=1024x1024
LINKEDIN_IMAGE_SIZE=1200x1200
INSTAGRAM_IMAGE_SIZE=1080x1350
FACEBOOK_IMAGE_SIZE=1200x630

REQUEST_TIMEOUT_SECONDS=300
OUTPUTS_DIR=./outputs
TRACES_FILE=./outputs/traces/generation-traces.jsonl
PORT=8000

# Google Sheets + Drive sync (service account JSON)
GOOGLE_CREDENTIALS_JSON_PATH=C:/path/to/service-account.json
GOOGLE_SPREADSHEET_ID=your_google_sheet_id
GOOGLE_SHEET_NAME=Sheet1
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
DEFAULT_COMPANY_LOGO_PATH=C:/path/to/company-logo.png
LOGO_INPUT_MODE=both
HEADLINE_OVERLAY_ENABLED=true

# Meta publishing
META_GRAPH_API_VERSION=v25.0
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
