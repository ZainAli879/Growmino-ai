OPENAI_API_KEY="your-openai-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

TEXT_PROVIDER=openai
CAPTION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1
OPENROUTER_HTTP_REFERER=https://your-site.example
OPENROUTER_APP_NAME=ai-postgen

IMAGE_PROVIDER=openai
IMAGE_SIZE=1024x1024
LINKEDIN_IMAGE_SIZE=1200x1200
INSTAGRAM_IMAGE_SIZE=1080x1350
FACEBOOK_IMAGE_SIZE=1200x630

REQUEST_TIMEOUT_SECONDS=300
OUTPUTS_DIR=./outputs
TRACES_FILE=./outputs/traces/generation-traces.jsonl
PORT=8000
PUBLIC_BASE_URL=
SOCIAL_MAX_IMAGE_BYTES=10000000
ENVIRONMENT=development
EXPOSE_TEST_UI=true
EXPOSE_API_DOCS=true
EXPOSE_OUTPUTS=false

# Production generated-post persistence
# Use only the business-management PostgreSQL database for POST /api/v1/posts.
DATABASE_URL=postgresql://APP_USER:PASSWORD@127.0.0.1:5432/business-management
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5

# Supabase Storage for generated post media
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_POST_MEDIA_BUCKET=post-media
SUPABASE_BUSINESS_ASSETS_BUCKET=business-assets
SUPABASE_REQUEST_TIMEOUT_SECONDS=30
LOCAL_UPLOADS_ROOT=./uploads

# API production guardrails
API_MAX_BODY_BYTES=25000000
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
API_GENERATION_RATE_LIMIT_REQUESTS=10
API_GENERATION_RATE_LIMIT_WINDOW_SECONDS=3600
API_PUBLISH_RATE_LIMIT_REQUESTS=60
API_PUBLISH_RATE_LIMIT_WINDOW_SECONDS=60
SECURE_HSTS_ENABLED=false

DEFAULT_COMPANY_LOGO_PATH=C:/path/to/company-logo.png
LOGO_INPUT_MODE=both

# Meta publishing
META_GRAPH_API_VERSION=v25.0
# Facebook Page IDs/tokens and Instagram account IDs/tokens are request-level inputs.
# Do not store user/page publishing tokens in this backend environment.

# API auth boundary
# Local/Postman testing can use X-Growmino-User-Id and X-Growmino-Business-Id while API_AUTH_REQUIRED=false.
# Production should use API_AUTH_REQUIRED=true, ALLOW_DEV_AUTH_HEADERS=false, and a real JWT verifier/secret.
API_AUTH_REQUIRED=false
GROWMINO_JWT_SECRET=
ALLOW_DEV_AUTH_HEADERS=true
AUTH_DEV_USER_ID=local-user
AUTH_DEV_BUSINESS_ID=local-business

# LinkedIn personal-profile OAuth
# Products required in LinkedIn Developer Portal: OpenID Connect + Share on LinkedIn
# Scopes: openid profile email w_member_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/integrations/linkedin/callback
# For Cloudflare local testing:
# LINKEDIN_REDIRECT_URI=https://generated.trycloudflare.com/api/v1/integrations/linkedin/callback
LINKEDIN_FRONTEND_SUCCESS_URL=http://localhost:8000/test-ui?linkedin=connected
LINKEDIN_FRONTEND_ERROR_URL=http://localhost:8000/test-ui?linkedin=error
LINKEDIN_OAUTH_STATE_TTL_SECONDS=600
LINKEDIN_MAX_IMAGE_BYTES=5000000
LINKEDIN_REQUEST_TIMEOUT_SECONDS=30
LINKEDIN_USER_AGENT=GrowMino-AI/1.0
LINKEDIN_STORE_FILE=./outputs/linkedin_store.json
LINKEDIN_REST_VERSION=202608
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Comma-separated explicit browser origins. Leave empty for server-to-server/Postman-only access.
CORS_ALLOW_ORIGINS=
