OPENAI_API_KEY="your-openai-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

TEXT_PROVIDER=openai
CAPTION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1
OPENROUTER_HTTP_REFERER=https://your-site.example
OPENROUTER_APP_NAME=ai-postgen

IMAGE_PROVIDER=openai
IMAGE_SIZE=1024x1024
LINKEDIN_IMAGE_SIZE=1200x1200
INSTAGRAM_IMAGE_SIZE=1080x1350
FACEBOOK_IMAGE_SIZE=1200x630

REQUEST_TIMEOUT_SECONDS=300
OUTPUTS_DIR=./outputs
TRACES_FILE=./outputs/traces/generation-traces.jsonl
PORT=8000

# Supabase Postgres + Storage
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-api-key
# SUPABASE_SECRET_KEY can be used as a fallback, but the backend prefers SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_STORAGE_BUCKET=generated-posts

# Google Sheets + Drive sync (service account JSON)
GOOGLE_CREDENTIALS_JSON_PATH=C:/path/to/service-account.json
GOOGLE_SPREADSHEET_ID=your_google_sheet_id
GOOGLE_SHEET_NAME=Sheet1
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
DEFAULT_COMPANY_LOGO_PATH=C:/path/to/company-logo.png
LOGO_INPUT_MODE=both

# Meta publishing
META_GRAPH_API_VERSION=v25.0
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
